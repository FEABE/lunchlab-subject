// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING    // 주문 접수
  CONFIRMED  // 주문 확인
  CANCELLED  // 주문 취소
}

model User {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  password      String
  name          String
  phone         String
  company       String          // 회사명
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshToken  String?
  orders        Order[]         // 사용자의 주문 목록
  productPolicy ProductPolicy[] // 사용자별 상품 정책
}

model Product {
  id            Int             @id @default(autoincrement())
  name          String
  basePrice     Int            // 기본 가격
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  productPolicy ProductPolicy[] // 상품별 정책
  orderItems    OrderItem[]     // 주문 상품 목록
}

model ProductPolicy {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  price     Int?     // 사용자별 커스텀 가격
  hidden    Boolean  @default(false)    // 구매 가능 여부
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId]) // 상품-사용자 조합은 유니크해야 함
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int
  deliveryDate  DateTime    // 배송 요청일
  status        OrderStatus @default(PENDING)
  totalAmount   Int         // 총 주문 금액
  comment       String?     // 주문 요청사항
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  orderItems    OrderItem[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  quantity    Int      // 주문 수량
  price       Int      // 주문 시점의 가격
  amount      Int      // 총 금액 (price * quantity)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}